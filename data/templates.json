              "detail": {
                "date": "2026-10-12",
                "title": "Education Empowers",
                "titleHighlight": "Dreams",
                "author": {
                  "prefix": "By",
                  "name": "Priya Sharma",
                  "role": "Education & Community Development",
                  "avatar": "/images/blog/author-priya.webp"
                },
                "intro": "Education is one of the most powerful tools to break the cycle of poverty and create equal opportunities for every child. At our organization, we believe that every child, regardless of their background, deserves access to quality education, a safe learning environment, and the support they need to reach their full potential.",
                "sections": [
                  {
                    "id": "creating-opportunities",
                    "title": "Creating Opportunities",
                    "titleHighlight": "Through Education",
                    "text": "Our education programs focus on providing school supplies, learning materials, tuition support, and mentorship to children from underprivileged communities. By removing barriers to education, we help children stay in school, gain confidence, and develop the skills they need for a brighter future.",
                    "image": {
                      "src": "/images/blog/detail-girl-writing.webp",
                      "alt": "A smiling girl writing in her notebook",
                      "width": 1466,
                      "height": 996
                    },
                    "titleBreak": true
                  },
                  {
                    "id": "real-impact",
                    "title": "Real Impact",
                    "titleHighlight": "in Communities",
                    "text": "Through the support of our donors, volunteers, and community partners, we have helped hundreds of children continue their education. Many of them are now excelling in their studies, pursuing higher education, and inspiring others in their communities.",
                    "image": {
                      "src": "/images/blog/detail-kids-group.webp",
                      "alt": "A group of happy school children",
                      "width": 1374,
                      "height": 736
                    }
                  },
                  {
                    "id": "looking",
                    "title": "Looking",
                    "titleHighlight": "Ahead",
                    "text": "We remain committed to expanding our education initiatives to reach more children and communities. With continued support, we can create lasting change and ensure that every child has the opportunity to learn, grow, and achieve their dreams.",
                    "image": {
                      "src": "/images/blog/detail-boy-reading.webp",
                      "alt": "A smiling boy reading at his desk",
                      "width": 1420,
                      "height": 778
                    }
                  }
                ],
                "quote": "“A child with education is a child with hope.\nWhen we educate a child, we empower a community\nand build a brighter tomorrow.”"
              },
              "detailPageUrl": "/our-blog/blog-detail"
            }
          }
        },
