        "Faq": {
          "variants": {
            "NGOFaq1": {
              "label": "FAQs",
              "title": "Frequently Asked",
              "titleHighlight": "Questions",
              "description": "Here you'll find answers to some of the most common questions about our organization, our programs, and ways you can support our mission.",
              "items": [
                {
                  "id": "what-is-the-main-focus-of-your-organization",
                  "icon": "FaBookOpen",
                  "tone": "orange",
                  "question": "What is the main focus of your organization?",
                  "answer": "Our main focus is to support underprivileged children and communities through education, healthcare, and essential resources. We work to create equal opportunities so that every child can learn, grow, and build a brighter future."
                },
                {
                  "id": "how-can-i-support-your-cause",
                  "icon": "FaUsers",
                  "tone": "green",
                  "question": "How can I support your cause?",
                  "answer": "You can support us by donating, sponsoring a child, volunteering your time, or sharing our work with friends and family. Every contribution, big or small, helps us reach more children and families."
                },
                {
                  "id": "are-my-donations-tax-deductible",
                  "icon": "FaHeart",
                  "tone": "pink",
                  "question": "Are my donations tax deductible?",
                  "answer": "Yes. Donations made to CareHaven Foundation are eligible for tax benefits as per applicable laws. You will receive an official receipt by email after every donation."
                },
                {
                  "id": "how-do-you-select-the-communities-or-children-to-support",
                  "icon": "FaGraduationCap",
                  "tone": "blue",
                  "question": "How do you select the communities or children to support?",
                  "answer": "We work with local schools, community leaders and field volunteers to identify families with the greatest need. Each case is reviewed so support reaches the children who need it most."
                },
                {
                  "id": "what-types-of-programs-do-you-run",
                  "icon": "FaHandHoldingHeart",
                  "tone": "amber",
                  "question": "What types of programs do you run?",
                  "answer": "We run education support, hunger relief, health and nutrition camps, women empowerment, animal welfare and disaster relief programs across the communities we serve."
                },
                {
                  "id": "how-can-i-stay-updated-on-your-work",
                  "icon": "FaFileAlt",
                  "tone": "purple",
                  "question": "How can I stay updated on your work?",
                  "answer": "Follow us on social media and read our blog for regular stories and updates. Donors also receive periodic reports showing how their contributions are being used."
                },
                {
                  "id": "can-i-volunteer-with-your-organization",
                  "icon": "FaHandshake",
                  "tone": "sage",
                  "question": "Can I volunteer with your organization?",
                  "answer": "Absolutely. We welcome volunteers for teaching, health camps, food drives and events. Contact us with your interests and availability, and our team will get in touch."
                },
                {
                  "id": "do-you-work-with-schools-and-local-communities",
                  "icon": "FaComments",
                  "tone": "sky",
                  "question": "Do you work with schools and local communities?",
                  "answer": "Yes. We partner closely with schools, local organizations and community groups to run our programs and make sure our support creates lasting change."
                }
              ]
            }
          }
        },
